<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.What2Eat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_window_background</item>
    </style>

    <!-- Splash screen theme using AndroidX SplashScreen compat.
         Pre-API 31: compat library renders the splash.
         API 31+: values-v31 overrides add native android: attributes. -->
    <style name="Theme.What2Eat.Splash" parent="Theme.SplashScreen">
        <!-- Match the window background to the splash so no black flash occurs -->
        <item name="android:windowBackground">@color/splash_window_background</item>
        <!-- SplashScreen compat attributes -->
        <item name="windowSplashScreenBackground">@color/splash_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_branding</item>
        <!-- Transition to the main theme after splash — prevents black screen -->
        <item name="postSplashScreenTheme">@style/Theme.What2Eat</item>
    </style>
</resources>